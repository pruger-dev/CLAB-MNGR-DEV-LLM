interfaces {
    et-0/0/0 {
        description "LAN A (SW1)";
        unit 0 {
            family inet {
                address 192.168.40.1/26;
            }
        }
    }
    et-0/0/1 {
        description "link to R2";
        unit 0 {
            family inet {
                address 192.168.40.112/31;
            }
        }
    }
    re0:mgmt-0 {
        unit 0 {
            family inet {
                address 172.20.20.72/24;
            }
        }
    }
}
routing-options {
    static {
        route 192.168.40.96/28 next-hop 192.168.40.114;
        route 192.168.40.100/32 discard;
    }
