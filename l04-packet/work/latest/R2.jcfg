    et-0/0/0 {
        description "link to R1";
        unit 0 {
            family inet {
                address 192.168.40.113/31;
            }
        }
    }
    et-0/0/1 {
        description "LAN C (H3)";
        unit 0 {
            family inet {
                address 192.168.40.97/28;
            }
        }
    }
    re0:mgmt-0 {
        unit 0 {
            family inet {
                address 172.20.20.73/24;
            }
        }
    }
}
