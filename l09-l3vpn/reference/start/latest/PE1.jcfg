interfaces {
    et-0/0/0 {
        description "to P";
        unit 0 {
            family inet {
                address 10.9.12.0/31;
            }
            family iso;
            family mpls;
        }
    }
    et-0/0/1 {
        description "customer A site 1 (HA1)";
    }
    et-0/0/2 {
        description "customer B site 1 (HB1)";
    }
    lo0 {
        unit 0 {
            family inet {
                address 10.9.0.1/32;
            }
            family iso {
                address 49.0001.0000.0000.0001.00;
            }
        }
    }
    re0:mgmt-0 {
        unit 0 {
            family inet {
                address 172.20.20.131/24;
            }
        }
    }
}
routing-options {
    router-id 10.9.0.1;
    autonomous-system 65100;
}
protocols {
    isis {
        interface et-0/0/0.0 {
            point-to-point;
        }
        interface lo0.0 {
            passive;
        }
        level 1 disable;
    }
    ldp {
        interface et-0/0/0.0;
        interface lo0.0;
    }
    mpls {
        interface et-0/0/0.0;
    }
}
