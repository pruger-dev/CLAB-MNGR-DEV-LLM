interfaces {
    ge-0/0/0 {
        description "to PTX1 et-0/0/0";
        unit 0 {
            family inet {
                address 10.0.0.2/30;
            }
        }
    }
    fxp0 {
        unit 0 {
            family inet {
                address 10.0.0.15/24;
            }
            family inet6 {
                address 2001:db8::2/64;
            }
        }
    }
    lo0 {
        unit 0 {
            family inet {
                address 192.168.255.2/32;
            }
        }
    }
