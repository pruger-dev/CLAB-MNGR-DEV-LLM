interfaces {
    et-0/0/0 {
        description "to P1";
        unit 0 {
            family inet {
                address 10.6.23.1/31;
            }
            family iso;
            family mpls;
        }
    }
    et-0/0/1 {
        description "to PE2";
        unit 0 {
            family inet {
                address 10.6.34.0/31;
            }
            family iso;
            family mpls;
        }
    }
    lo0 {
        unit 0 {
            family inet {
                address 10.6.0.3/32;
            }
            family iso {
                address 49.0001.0000.0000.0003.00;
            }
        }
    }
    re0:mgmt-0 {
        unit 0 {
            family inet {
                address 172.20.20.113/24;
            }
        }
    }
}
protocols {
    isis {
        interface et-0/0/0.0 {
            point-to-point;
        }
        interface et-0/0/1.0 {
            point-to-point;
        }
        interface lo0.0 {
            passive;
        }
        source-packet-routing {
            srgb start-label 16000 index-range 8000;
            node-segment ipv4-index 3;
        }
        level 1 disable;
    }
    ldp {
        interface lo0.0;
    }
    mpls {
        interface et-0/0/0.0;
        interface et-0/0/1.0;
    }
}
