interfaces {
    et-0/0/0 {
        description "to R1";
        unit 0 {
            family inet {
                address 10.8.12.1/31;
            }
            family iso;
        }
    }
    et-0/0/1 {
        description "to CUST (AS 65200)";
        unit 0 {
            family inet {
                address 10.8.200.0/31;
            }
        }
    }
    et-0/0/2 {
        description "LAN (H1)";
        unit 0 {
            family inet {
                address 10.8.1.1/24;
            }
        }
    }
    et-0/0/3 {
        description "to ISP-B (AS 65002)";
        unit 0 {
            family inet {
                address 172.16.2.1/31;
            }
        }
    }
    lo0 {
        unit 0 {
            family inet {
                address 10.8.0.2/32;
            }
            family iso {
                address 49.0001.0000.0000.0002.00;
            }
        }
    }
    re0:mgmt-0 {
        unit 0 {
            family inet {
                address 172.20.20.162/24;
            }
        }
    }
}
policy-options {
    prefix-list customer-prefixes {
        192.0.2.0/25;
    }
    policy-statement export-ours {
        term ours {
            from {
                protocol aggregate;
                route-filter 10.8.0.0/16 exact;
            }
            then accept;
        }
    }
    policy-statement from-CUST {
        term theirs {
            from {
                prefix-list customer-prefixes;
            }
            then {
                community add customer;
                accept;
            }
        }
        term rest {
            then reject;
        }
    }
    policy-statement from-ISP-A-typo {
        term all {
            then {
                local-preference 300;
                community add transit;
                accept;
            }
        }
    }
    policy-statement from-ISP-B {
        term all {
            then {
                community add transit;
                accept;
            }
        }
    }
    policy-statement next-hop-self {
        term ibgp {
            then {
                next-hop self;
            }
        }
    }
    policy-statement to-CUST {
        term default {
            from {
                route-filter 0.0.0.0/0 exact;
            }
            then accept;
        }
        term rest {
            then reject;
        }
    }
    policy-statement to-ISP {
        term own {
            from {
                protocol aggregate;
                route-filter 10.8.0.0/16 exact;
            }
            then {
                community add own;
                accept;
            }
        }
        term customer {
            from community customer;
            then accept;
        }
        term rest {
            then reject;
        }
    }
    policy-statement to-ISP-B {
        term prepend {
            from protocol bgp;
            then {
                as-path-prepend "65100 65100";
                next policy;
            }
        }
        term own {
            from protocol aggregate;
            then {
                as-path-prepend "65100 65100";
                next policy;
            }
        }
    }
    community customer members 65100:2000;
    community own members 65100:1000;
    community transit members 65100:3000;
}
routing-options {
    router-id 10.8.0.2;
    autonomous-system 65100;
    static {
        route 0.0.0.0/0 discard;
    }
    aggregate {
        route 10.8.0.0/16;
    }
}
protocols {
    bgp {
        group internal {
            type internal;
            local-address 10.8.0.2;
            export next-hop-self;
            neighbor 10.8.0.1;
        }
        group ISP-B {
            type external;
            import [ from-ISP-B from-ISP-A-typo ];
            export [ to-ISP-B to-ISP ];
            peer-as 65002;
            neighbor 172.16.2.0;
        }
        group CUST {
            type external;
            import from-CUST;
            family inet {
                unicast {
                    prefix-limit {
                        maximum 10;
                        teardown;
                    }
                }
            }
            export to-CUST;
            peer-as 65200;
            neighbor 10.8.200.1;
        }
    }
    isis {
        interface et-0/0/0.0 {
            point-to-point;
        }
        interface et-0/0/2.0 {
            passive;
        }
        interface lo0.0 {
            passive;
        }
        level 1 disable;
    }
}
