    services {
        ssh;
        extension-service {
            request-response {
                grpc {
                    clear-text {
                        port 32767;
                    }
                }
            }
        }
    }
}
interfaces {
    et-0/0/0 {
        description "to R2";
        unit 0 {
            family inet {
                address 10.8.12.0/31;
            }
            family iso;
        }
    }
    et-0/0/1 {
        description "to ISP-A (AS 65001)";
        unit 0 {
            family inet {
                address 172.16.1.1/31;
            }
        }
    }
    lo0 {
        unit 0 {
            family inet {
                address 10.8.0.1/32;
            }
            family iso {
                address 49.0001.0000.0000.0001.00;
            }
        }
    }
    re0:mgmt-0 {
        unit 0 {
            family inet {
                address 172.20.20.161/24;
            }
        }
    }
}
policy-options {
    policy-statement export-ours {
        term ours {
            from {
                protocol aggregate;
                route-filter 10.8.0.0/16 exact;
            }
            then accept;
        }
    }
    policy-statement from-ISP-A {
        term all {
            then {
                local-preference 200;
                community add transit;
                accept;
            }
        }
    }
    policy-statement next-hop-self {
        term ibgp {
            then {
                next-hop self;
            }
        }
    }
    policy-statement to-ISP {
        term own {
            from {
                protocol direct;
                route-filter 10.8.0.0/16 exact;
            }
            then {
                community add own;
                accept;
            }
        }
        term customer {
            from community customer;
            then accept;
        }
        term rest {
            then reject;
        }
    }
    community customer members 65100:2000;
    community own members 65100:1000;
    community transit members 65100:3000;
}
routing-options {
    router-id 10.8.0.1;
    autonomous-system 65100;
    aggregate {
        route 10.8.0.0/16;
    }
}
protocols {
    bgp {
        group internal {
            type internal;
            local-address 10.8.0.1;
            export next-hop-self;
            neighbor 10.8.0.2;
        }
        group ISP-A {
            type external;
            import from-ISP-A;
            export to-ISP;
            peer-as 65001;
            neighbor 172.16.1.0;
        }
    }
    isis {
        interface et-0/0/0.0 {
            point-to-point;
        }
        interface lo0.0 {
            passive;
        }
        level 1 disable;
    }
}
