set version 26.2R1.7-EVO
set system host-name R2
set system root-authentication encrypted-password "$6$9YSzwiCD$ZiMI1N.5fcWCe5fH8hZz/FtISY4K8QKjv9p0w6Hkyct71ke1bn3OQQk0oi7/l5Sn8yP1CClO9CeGSMpNQcFjT/"
set system login user admin uid 500
set system login user admin class superuser
set system login user admin authentication encrypted-password "$6$9YSzwiCD$ZiMI1N.5fcWCe5fH8hZz/FtISY4K8QKjv9p0w6Hkyct71ke1bn3OQQk0oi7/l5Sn8yP1CClO9CeGSMpNQcFjT/"
set system syslog file interactive-commands interactive-commands any
set system syslog file messages any notice
set system syslog file messages authorization info
set system services ssh
set system services extension-service request-response grpc clear-text port 32767
set interfaces et-0/0/0 description "to R1"
set interfaces et-0/0/0 unit 0 family inet address 10.8.12.1/31
set interfaces et-0/0/0 unit 0 family iso
set interfaces et-0/0/1 description "to CUST (AS 65200)"
set interfaces et-0/0/1 unit 0 family inet address 10.8.200.0/31
set interfaces et-0/0/2 description "LAN (H1)"
set interfaces et-0/0/2 unit 0 family inet address 10.8.1.1/24
set interfaces et-0/0/3 description "to ISP-B (AS 65002)"
set interfaces et-0/0/3 unit 0 family inet address 172.16.2.1/31
set interfaces lo0 unit 0 family inet address 10.8.0.2/32
set interfaces lo0 unit 0 family iso address 49.0001.0000.0000.0002.00
set interfaces re0:mgmt-0 unit 0 family inet address 172.20.20.162/24
set policy-options prefix-list customer-prefixes 192.0.2.0/24
set policy-options policy-statement export-ours term ours from protocol aggregate
set policy-options policy-statement export-ours term ours from route-filter 10.8.0.0/16 exact
set policy-options policy-statement export-ours term ours then accept
set policy-options policy-statement from-CUST term theirs from prefix-list customer-prefixes
set policy-options policy-statement from-CUST term theirs then community add customer
set policy-options policy-statement from-CUST term theirs then accept
set policy-options policy-statement from-CUST term rest then reject
set policy-options policy-statement from-ISP-B term all then community add transit
set policy-options policy-statement from-ISP-B term all then accept
set policy-options policy-statement next-hop-self term ibgp then next-hop self
set policy-options policy-statement to-CUST term default from route-filter 0.0.0.0/0 exact
set policy-options policy-statement to-CUST term default then accept
set policy-options policy-statement to-CUST term rest then reject
set policy-options policy-statement to-ISP term own from protocol aggregate
set policy-options policy-statement to-ISP term own from route-filter 10.8.0.0/16 exact
set policy-options policy-statement to-ISP term own then community add own
set policy-options policy-statement to-ISP term own then accept
set policy-options policy-statement to-ISP term customer from community customer
set policy-options policy-statement to-ISP term customer then accept
set policy-options policy-statement to-ISP term rest then reject
set policy-options policy-statement to-ISP-B term prepend from protocol bgp
set policy-options policy-statement to-ISP-B term prepend then as-path-prepend "65100 65100"
set policy-options policy-statement to-ISP-B term prepend then next policy
set policy-options policy-statement to-ISP-B term own from protocol aggregate
set policy-options policy-statement to-ISP-B term own then as-path-prepend "65100 65100"
set policy-options policy-statement to-ISP-B term own then next policy
set policy-options community customer members 65100:2000
set policy-options community own members 65100:1000
set policy-options community transit members 65100:3000
set routing-options router-id 10.8.0.2
set routing-options autonomous-system 65100
set routing-options static route 0.0.0.0/0 discard
set routing-options aggregate route 10.8.0.0/16
set protocols bgp group internal type internal
set protocols bgp group internal local-address 10.8.0.2
set protocols bgp group internal export next-hop-self
set protocols bgp group internal neighbor 10.8.0.1
set protocols bgp group ISP-B type external
set protocols bgp group ISP-B import from-ISP-B
set protocols bgp group ISP-B export to-ISP-B
set protocols bgp group ISP-B export to-ISP
set protocols bgp group ISP-B peer-as 65002
set protocols bgp group ISP-B neighbor 172.16.2.0
set protocols bgp group CUST type external
set protocols bgp group CUST import from-CUST
set protocols bgp group CUST family inet unicast prefix-limit maximum 10
set protocols bgp group CUST family inet unicast prefix-limit teardown
set protocols bgp group CUST export to-CUST
set protocols bgp group CUST peer-as 65200
set protocols bgp group CUST neighbor 10.8.200.1
set protocols isis interface et-0/0/0.0 point-to-point
set protocols isis interface et-0/0/2.0 passive
set protocols isis interface lo0.0 passive
set protocols isis level 1 disable
