chassis {
    fpc 0 {
        pic 0 {
            number-of-ports 56;
        }
    }
}
interfaces {
    ge-0/0/0 {
        description "A to-cjunosevolved";
        unit 0 {
            family inet {
                address 10.0.23.1/31;
            }
        }
    }
    ge-0/0/1 {
        description "A to-xrv9k";
        unit 0 {
            family inet {
                address 10.0.34.0/31;
            }
        }
    }
    fxp0 {
        unit 0 {
            family inet {
                address 10.0.0.15/24;
            }
            family inet6 {
                address 2001:db8::2/64;
            }
        }
    }
    lo0 {
        unit 0 {
            description "A loopback";
            family inet {
                address 10.255.0.3/32;
            }
        }
    }
}
policy-options {
    prefix-list RESTORE-A {
        10.255.0.0/24;
    }
}
routing-instances {
    mgmt_junos {
        routing-options {
            rib mgmt_junos.inet6.0 {
                static {
                    route ::/0 next-hop 2001:db8::1;
                }
            }
            static {
                route 0.0.0.0/0 next-hop 10.0.0.2;
            }
        }
    }
}
routing-options {
    router-id 10.255.0.3;
    static {
        route 192.0.2.3/32 discard;
    }
}
protocols {
    ospf {
        area 0.0.0.0 {
            interface ge-0/0/0.0 {
                interface-type p2p;
            }
            interface ge-0/0/1.0 {
                interface-type p2p;
            }
            interface lo0.0 {
                passive;
            }
        }
    }
}
