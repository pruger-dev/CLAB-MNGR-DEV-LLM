! Command: show running-config
! device: ceos (cEOSLab, EOS-4.35.0F-44178984.4350F (engineering build))
!
no aaa root
!
username admin privilege 15 role network-admin secret sha512 $6$vhzg2j3egNPlS8Dp$Jb2ETjQX0c6o6TmRvZV2ctZvCAVYKry1nxYR6aqz9YAazbuz1rqi6ultWcnS3jiiagZ4l5v56B8OJbUi4fMwr0
!
management api http-commands
   no shutdown
!
no service interface inactive port-id allocation disabled
!
transceiver qsfp default-mode 4x10G
!
service routing protocols model multi-agent
!
hostname ceos
!
spanning-tree mode mstp
!
system l1
   unsupported speed action error
   unsupported error-correction action error
!
management api gnmi
   transport grpc default
!
management api netconf
   transport ssh default
!
interface Ethernet1
   description A to-cjunosevolved
   no switchport
   ip address 10.0.12.0/31
   ip ospf network point-to-point
   ip ospf area 0.0.0.0
!
interface Ethernet2
   description A to-xrv9k
   no switchport
   ip address 10.0.41.1/31
   ip ospf network point-to-point
   ip ospf area 0.0.0.0
!
interface Loopback0
   description A loopback
   ip address 10.255.0.1/32
   ip ospf area 0.0.0.0
!
interface Management0
   ip address 172.20.20.101/24
!
ip routing
!
ip prefix-list RESTORE-A seq 10 permit 10.255.0.0/24 le 32
!
ip route 0.0.0.0/0 172.20.20.1
ip route 192.0.2.1/32 Null0
!
router multicast
   ipv4
      software-forwarding kernel
   !
   ipv6
      software-forwarding kernel
!
router ospf 1
   router-id 10.255.0.1
   passive-interface Loopback0
   max-lsa 12000
!
end
