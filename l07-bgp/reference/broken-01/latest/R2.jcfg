interfaces {
    et-0/0/0 {
        description "to R1";
        unit 0 {
            family inet {
                address 10.7.12.1/31;
            }
            family iso;
        }
    }
    et-0/0/1 {
        description "to CUST (AS 65200)";
        unit 0 {
            family inet {
                address 10.7.200.0/31;
            }
        }
    }
    et-0/0/2 {
        description "LAN (H1)";
        unit 0 {
            family inet {
                address 10.7.1.1/24;
            }
        }
    }
    lo0 {
        unit 0 {
            family inet {
                address 10.7.0.2/32;
            }
            family iso {
                address 49.0001.0000.0000.0002.00;
            }
        }
    }
    re0:mgmt-0 {
        unit 0 {
            family inet {
                address 172.20.20.132/24;
            }
        }
    }
}
policy-options {
    policy-statement export-ours {
        term ours {
            from {
                protocol aggregate;
                route-filter 10.7.0.0/16 exact;
            }
            then accept;
        }
    }
    policy-statement next-hop-self {
        term ibgp {
            then {
                next-hop self;
            }
        }
    }
}
routing-options {
    router-id 10.7.0.2;
    autonomous-system 65100;
    aggregate {
        route 10.7.0.0/16;
    }
}
protocols {
    bgp {
        group internal {
            type internal;
            local-address 10.7.0.2;
            neighbor 10.7.0.1;
        }
        group CUST {
            type external;
            export export-ours;
            peer-as 65200;
            neighbor 10.7.200.1;
        }
    }
    isis {
        interface et-0/0/0.0 {
            point-to-point;
        }
        interface et-0/0/2.0 {
            passive;
        }
        interface lo0.0 {
            passive;
        }
        level 1 disable;
    }
}
