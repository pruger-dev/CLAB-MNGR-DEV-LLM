set version 26.2R1.7-EVO
set system host-name R1
set system root-authentication encrypted-password "$6$9YSzwiCD$ZiMI1N.5fcWCe5fH8hZz/FtISY4K8QKjv9p0w6Hkyct71ke1bn3OQQk0oi7/l5Sn8yP1CClO9CeGSMpNQcFjT/"
set system login user admin uid 500
set system login user admin class superuser
set system login user admin authentication encrypted-password "$6$9YSzwiCD$ZiMI1N.5fcWCe5fH8hZz/FtISY4K8QKjv9p0w6Hkyct71ke1bn3OQQk0oi7/l5Sn8yP1CClO9CeGSMpNQcFjT/"
set system syslog file interactive-commands interactive-commands any
set system syslog file messages any notice
set system syslog file messages authorization info
set system services ssh
set system services extension-service request-response grpc clear-text port 32767
set interfaces et-0/0/0 description "to R2"
set interfaces et-0/0/0 unit 0 family inet address 10.7.12.0/31
set interfaces et-0/0/0 unit 0 family iso
set interfaces et-0/0/1 description "to ISP-A (AS 65001)"
set interfaces et-0/0/1 unit 0 family inet address 172.16.1.1/31
set interfaces lo0 unit 0 family inet address 10.7.0.1/32
set interfaces lo0 unit 0 family iso address 49.0001.0000.0000.0001.00
set interfaces re0:mgmt-0 unit 0 family inet address 172.20.20.191/24
set policy-options policy-statement export-ours term ours from protocol aggregate
set policy-options policy-statement export-ours term ours from route-filter 10.7.0.0/16 exact
set policy-options policy-statement export-ours term ours then accept
set policy-options policy-statement next-hop-self term ibgp then next-hop self
set routing-options router-id 10.7.0.1
set routing-options autonomous-system 65100
set protocols bgp group ISP-A type external
set protocols bgp group ISP-A export export-ours
set protocols bgp group ISP-A peer-as 65002
set protocols bgp group ISP-A neighbor 172.16.1.0
set protocols bgp group internal type internal
set protocols bgp group internal local-address 10.7.0.1
set protocols bgp group internal export next-hop-self
set protocols bgp group internal neighbor 10.7.0.2
set protocols isis interface et-0/0/0.0 point-to-point
set protocols isis interface lo0.0 passive
set protocols isis level 1 disable
