interfaces {
    et-0/0/0 {
        description "to PE1";
        mtu 9192;
        unit 0 {
            family inet {
                address 10.10.14.1/31;
            }
            family iso;
            family mpls;
        }
    }
    et-0/0/1 {
        description "to PE2";
        mtu 9192;
        unit 0 {
            family inet {
                address 10.10.24.1/31;
            }
            family iso;
            family mpls;
        }
    }
    et-0/0/2 {
        description "to PE3";
        mtu 9192;
        unit 0 {
            family inet {
                address 10.10.34.1/31;
            }
            family iso;
            family mpls;
        }
    }
    lo0 {
        unit 0 {
            family inet {
                address 10.10.0.4/32;
            }
            family iso {
                address 49.0001.0000.0000.0004.00;
            }
        }
    }
    re0:mgmt-0 {
        unit 0 {
            family inet {
                address 172.20.20.144/24;
            }
        }
    }
}
routing-options {
    router-id 10.10.0.4;
    autonomous-system 65100;
}
protocols {
    bgp {
        group rr-clients {
            type internal;
            local-address 10.10.0.4;
            family evpn {
                signaling;
            }
            cluster 10.10.0.4;
            neighbor 10.10.0.1;
            neighbor 10.10.0.2;
            neighbor 10.10.0.3;
        }
    }
    isis {
        interface et-0/0/0.0 {
            point-to-point;
        }
        interface et-0/0/1.0 {
            point-to-point;
        }
        interface et-0/0/2.0 {
            point-to-point;
        }
        interface lo0.0 {
            passive;
        }
        source-packet-routing {
            srgb start-label 16000 index-range 8000;
            node-segment ipv4-index 4;
        }
        level 1 disable;
    }
    mpls {
        interface et-0/0/0.0;
        interface et-0/0/1.0;
        interface et-0/0/2.0;
    }
}
