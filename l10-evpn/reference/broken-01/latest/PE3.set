set interfaces et-0/0/2 description "customer C site 3 (HC3), trunk"
set interfaces et-0/0/2 flexible-vlan-tagging
set interfaces et-0/0/2 encapsulation flexible-ethernet-services
set interfaces et-0/0/2 unit 10 encapsulation vlan-ccc
set interfaces et-0/0/2 unit 10 vlan-id 11
set interfaces et-0/0/2 unit 20 encapsulation vlan-bridge
set interfaces et-0/0/2 unit 20 vlan-id 20
set interfaces lo0 unit 0 family inet address 10.10.0.3/32
set interfaces lo0 unit 0 family iso address 49.0001.0000.0000.0003.00
set interfaces re0:mgmt-0 unit 0 family inet address 172.20.20.143/24
set routing-instances ELAN-B instance-type mac-vrf
set routing-instances ELAN-B protocols evpn encapsulation mpls
