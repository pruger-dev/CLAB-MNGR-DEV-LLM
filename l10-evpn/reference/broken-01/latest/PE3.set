set routing-instances ELAN-C protocols evpn encapsulation mpls
set routing-instances ELAN-C service-type vlan-based
set routing-instances ELAN-C interface et-0/0/2.20
set routing-instances ELAN-C route-distinguisher 10.10.0.3:320
set routing-instances ELAN-C vrf-target target:65100:320
set routing-instances ELAN-C vlans C20 vlan-id 20
set routing-instances ELAN-C vlans C20 interface et-0/0/2.20
