interfaces {
    et-0/0/0 {
        description "to P";
        mtu 9192;
        unit 0 {
            family inet {
                address 10.10.34.0/31;
            }
            family iso;
            family mpls;
        }
    }
    et-0/0/1 {
        description "customer B site 3 (HB3)";
        unit 0 {
            family ethernet-switching {
                interface-mode access;
                vlan {
                    members B200;
                }
            }
        }
    }
    et-0/0/2 {
        description "customer C site 3 (HC3), trunk";
        flexible-vlan-tagging;
        encapsulation flexible-ethernet-services;
        unit 10 {
            encapsulation vlan-ccc;
            vlan-id 11;
        }
        unit 20 {
            encapsulation vlan-bridge;
            vlan-id 20;
        }
    }
    lo0 {
        unit 0 {
            family inet {
                address 10.10.0.3/32;
            }
            family iso {
                address 49.0001.0000.0000.0003.00;
            }
        }
    }
    re0:mgmt-0 {
        unit 0 {
            family inet {
                address 172.20.20.143/24;
            }
        }
    }
}
routing-instances {
    ELAN-B {
        instance-type mac-vrf;
        protocols {
            evpn {
                encapsulation mpls;
            }
        }
        service-type vlan-based;
        interface et-0/0/1.0;
        route-distinguisher 10.10.0.3:200;
        vrf-target target:65100:200;
        vlans {
            B200 {
                vlan-id 200;
            }
        }
    }
    ELAN-C {
        instance-type mac-vrf;
        protocols {
            evpn {
                encapsulation mpls;
            }
        }
        service-type vlan-based;
        interface et-0/0/2.20;
        route-distinguisher 10.10.0.3:320;
        vrf-target target:65100:320;
        vlans {
            C20 {
                vlan-id 20;
                interface et-0/0/2.20;
            }
        }
    }
    ELINE-C {
        instance-type evpn-vpws;
        protocols {
            evpn {
                interface et-0/0/2.10 {
                    vpws-service-id {
                        local 13;
                        remote 11;
                    }
                }
            }
        }
        interface et-0/0/2.10;
        route-distinguisher 10.10.0.3:310;
        vrf-target target:65100:310;
    }
}
routing-options {
    router-id 10.10.0.3;
    autonomous-system 65100;
}
protocols {
    bgp {
        group rr {
            type internal;
            local-address 10.10.0.3;
            family evpn {
                signaling;
            }
            neighbor 10.10.0.4;
        }
    }
    isis {
        interface et-0/0/0.0 {
            point-to-point;
        }
        interface lo0.0 {
            passive;
        }
        source-packet-routing {
            srgb start-label 16000 index-range 8000;
            node-segment ipv4-index 3;
        }
        level 1 disable;
    }
    mpls {
        interface et-0/0/0.0;
    }
}
