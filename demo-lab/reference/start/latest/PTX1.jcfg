interfaces {
    lo0 {
        unit 0 {
            family inet {
                address 10.0.0.1/32;
            }
        }
    }
    re0:mgmt-0 {
        unit 0 {
            family inet {
                address 172.20.20.2/24;
            }
        }
    }
}
policy-options {
    policy-statement advertise-loopback {
        term direct {
            from {
                protocol direct;
                route-filter 10.0.0.0/24 orlonger;
            }
            then accept;
        }
    }
}
routing-options {
    router-id 10.0.0.1;
    autonomous-system 65001;
}
protocols {
    bgp {
        group underlay {
            type external;
            export advertise-loopback;
            peer-as 65002;
            neighbor 10.1.1.2;
        }
    }
}
