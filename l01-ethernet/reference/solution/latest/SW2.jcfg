chassis {
    fpc 0 {
        pic 0 {
            number-of-ports 56;
        }
    }
}
interfaces {
    ge-0/0/0 {
        description H3;
        unit 0 {
            family ethernet-switching {
                interface-mode access;
                vlan {
                    members students-a;
                }
            }
        }
    }
    ge-0/0/1 {
        description H4;
        unit 0 {
            family ethernet-switching {
                interface-mode access;
                vlan {
                    members students-b;
                }
            }
        }
    }
    ge-0/0/9 {
        description "uplink to SW1";
        unit 0 {
            family ethernet-switching {
                interface-mode trunk;
                vlan {
                    members [ students-a students-b ];
                }
            }
        }
    }
    fxp0 {
        unit 0 {
            family inet {
                address 10.0.0.15/24;
            }
            family inet6 {
                address 2001:db8::2/64;
            }
        }
    }
}
routing-instances {
    mgmt_junos {
        routing-options {
            rib mgmt_junos.inet6.0 {
                static {
                    route ::/0 next-hop 2001:db8::1;
                }
            }
            static {
                route 0.0.0.0/0 next-hop 10.0.0.2;
            }
        }
    }
}
vlans {
    students-a {
        vlan-id 10;
    }
    students-b {
        vlan-id 20;
    }
}
