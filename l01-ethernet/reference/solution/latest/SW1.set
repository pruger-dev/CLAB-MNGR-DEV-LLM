set version 23.2R1.14
set system host-name SW1
set system root-authentication encrypted-password "$6$uQPf08iE$1smLm0.CR8RgOO0v/VYQ8P7V6jRJCQv5YrUrENe5mxD6t.HWJFXvMdE6tD57ya4IYK8e45MCYzHcrI7aW0ZmN/"
set system login user admin uid 2000
set system login user admin class super-user
set system login user admin authentication encrypted-password "$6$/wkZdELs$P7e1h70m3FMSFAJMn/iaHhKHr3vTPEvESZylCTA9upG.IvoISJwJQbu99TLrjPtIJcDqIMWXgR93SAd0..4xt/"
set system services ssh root-login allow
set system services netconf ssh
set system management-instance
set chassis fpc 0 pic 0 number-of-ports 56
set interfaces ge-0/0/0 description H1
set interfaces ge-0/0/0 unit 0 family ethernet-switching interface-mode access
set interfaces ge-0/0/0 unit 0 family ethernet-switching vlan members students-a
set interfaces ge-0/0/1 description H2
set interfaces ge-0/0/1 unit 0 family ethernet-switching interface-mode access
set interfaces ge-0/0/1 unit 0 family ethernet-switching vlan members students-b
set interfaces ge-0/0/9 description "uplink to SW2"
set interfaces ge-0/0/9 unit 0 family ethernet-switching interface-mode trunk
set interfaces ge-0/0/9 unit 0 family ethernet-switching vlan members students-a
set interfaces ge-0/0/9 unit 0 family ethernet-switching vlan members students-b
set interfaces fxp0 unit 0 family inet address 10.0.0.15/24
set interfaces fxp0 unit 0 family inet6 address 2001:db8::2/64
set routing-instances mgmt_junos routing-options rib mgmt_junos.inet6.0 static route ::/0 next-hop 2001:db8::1
set routing-instances mgmt_junos routing-options static route 0.0.0.0/0 next-hop 10.0.0.2
set vlans students-a vlan-id 10
set vlans students-b vlan-id 20
