interfaces {
    ge-0/0/0 {
        description H1;
        unit 0 {
            family ethernet-switching;
        }
    }
    ge-0/0/1 {
        description H2;
        unit 0 {
            family ethernet-switching;
        }
    }
    ge-0/0/9 {
        description "uplink to SW2";
        unit 0 {
            family ethernet-switching;
        }
    }
    fxp0 {
        unit 0 {
            family inet {
                address 10.0.0.15/24;
            }
            family inet6 {
                address 2001:db8::2/64;
            }
        }
    }
}
routing-instances {
    mgmt_junos {
        routing-options {
            rib mgmt_junos.inet6.0 {
                static {
                    route ::/0 next-hop 2001:db8::1;
                }
            }
            static {
                route 0.0.0.0/0 next-hop 10.0.0.2;
            }
        }
    }
}
